{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Mochi",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "watch"
    },
    {
      // A throwaway profile: no other extensions, default settings. Theme and
      // setting changes stay in the test window. Closer to a fresh install.
      "name": "Run Mochi (clean profile)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--profile-temp", "--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "watch"
    }
  ]
}
