{
  "name": "mochi-companion",
  "displayName": "Mochi Companion",
  "description": "A cozy AI companion that lives in VS Code.",
  "version": "0.0.1",
  "publisher": "arjungyawali",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/arjn001/project-mochi.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, Mochi never runs anything in the folder, like setting up a Python project."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "mochi",
          "title": "Mochi",
          "icon": "media/icons/mochi-here.svg"
        }
      ]
    },
    "views": {
      "mochi": [
        {
          "id": "mochi.home",
          "name": "Mochi"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mochi.home",
        "contents": "Hi! Mochi is still settling in. More is coming soon."
      }
    ],
    "commands": [
      {
        "command": "mochi.open",
        "title": "Open Mochi",
        "category": "Mochi"
      },
      {
        "command": "mochi.ask",
        "title": "Ask (preview)",
        "category": "Mochi"
      },
      {
        "command": "mochi.explainError",
        "title": "Explain this error",
        "category": "Mochi"
      },
      {
        "command": "mochi.explainSelection",
        "title": "Explain this",
        "category": "Mochi"
      },
      {
        "command": "mochi.dim",
        "title": "Switch to a dark theme",
        "category": "Mochi"
      },
      {
        "command": "mochi.setUpPython",
        "title": "Set up a Python project",
        "category": "Mochi"
      },
      {
        "command": "mochi.focus",
        "title": "Start a focus session",
        "category": "Mochi"
      },
      {
        "command": "mochi.focus.stop",
        "title": "Stop the focus session",
        "category": "Mochi"
      },
      {
        "command": "mochi.focus.menu",
        "title": "Focus session options",
        "category": "Mochi"
      },
      {
        "command": "mochi.setName",
        "title": "What should I call you?",
        "category": "Mochi"
      },
      {
        "command": "mochi.forgetName",
        "title": "Forget my name",
        "category": "Mochi"
      },
      {
        "command": "mochi.chooseBrain",
        "title": "Choose a brain",
        "category": "Mochi"
      },
      {
        "command": "mochi.addClaudeKey",
        "title": "Add a Claude key",
        "category": "Mochi"
      },
      {
        "command": "mochi.removeClaudeKey",
        "title": "Remove my Claude key",
        "category": "Mochi"
      },
      {
        "command": "mochi.forgetEverything",
        "title": "Forget everything",
        "category": "Mochi"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mochi.focus",
          "when": "!mochi.focusing"
        },
        {
          "command": "mochi.focus.stop",
          "when": "mochi.focusing"
        },
        {
          "command": "mochi.focus.menu",
          "when": "false"
        },
        {
          "command": "mochi.removeClaudeKey",
          "when": "mochi.hasClaudeKey"
        }
      ],
      "editor/context": [
        {
          "command": "mochi.explainSelection",
          "when": "editorHasSelection",
          "group": "mochi@1"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "mochi",
        "required": [
          "step"
        ],
        "properties": {
          "step": {
            "type": "string",
            "description": "Which setup step Mochi is running."
          }
        }
      }
    ],
    "configuration": {
      "title": "Mochi",
      "properties": {
        "mochi.speakUp": {
          "type": "string",
          "enum": [
            "quiet",
            "gentle",
            "chatty"
          ],
          "enumItemLabels": [
            "Quiet",
            "Gentle",
            "Chatty"
          ],
          "enumDescriptions": [
            "Mochi stays in the status bar and only talks when you open it.",
            "Mochi offers help and kind words now and then.",
            "Mochi says hello more often, with fun facts and small talk."
          ],
          "default": "gentle",
          "markdownDescription": "How often Mochi speaks up on its own. Mochi always answers when you open it."
        },
        "mochi.brain": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Which brain Mochi thinks with, like `copilot/auto`. Leave empty to let Mochi choose: Copilot's Auto when it's available. Use **Mochi: Choose a brain** to pick from what's available. Only you can change this; a project's settings can't."
        },
        "mochi.learningMode": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Help me learn instead of handing me answers. For homework, your code, and errors, Mochi explains first, gives a hint if you ask, and shows the fix only when you ask for it. Turn off for direct answers, fixes included. Only you can change this; a project's settings can't."
        },
        "mochi.focusMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 120,
          "markdownDescription": "How long a focus session lasts, in minutes."
        },
        "mochi.lateHour": {
          "type": "integer",
          "default": 23,
          "minimum": 0,
          "maximum": 23,
          "markdownDescription": "The hour when late night starts, from 0 to 23. Late night lasts until 5:00. Mochi greets the night owl and keeps you company from then on."
        }
      }
    },
    "icons": {
      "mochi-here": {
        "description": "Mochi is here",
        "default": {
          "fontPath": "media/font/mochi-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "mochi-purring": {
        "description": "Mochi is purring",
        "default": {
          "fontPath": "media/font/mochi-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "mochi-napping": {
        "description": "Mochi is napping",
        "default": {
          "fontPath": "media/font/mochi-icons.woff",
          "fontCharacter": "\\E003"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['out', 'dist']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./ && node esbuild.mjs",
    "watch:tsc": "tsc -watch -p ./",
    "watch:esbuild": "node esbuild.mjs --watch",
    "build:icons": "fantasticon",
    "notices": "node esbuild.mjs --notices",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --skip-license --no-dependencies",
    "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "fantasticon": "^4.1.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1"
  }
}
