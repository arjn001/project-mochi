{
  "name": "mochi-companion",
  "displayName": "Mochi Companion",
  "description": "A cozy AI companion that lives in VS Code.",
  "version": "0.0.1",
  "publisher": "arjungyawali",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/arjn001/project-mochi.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mochi.sayHello",
        "title": "Say Hello",
        "category": "Mochi"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  }
}
