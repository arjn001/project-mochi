{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "mocha"],
    "rootDir": "src",
    "outDir": "out",
    "sourceMap": true,
    "strict": true
  },
  "include": ["src"],
  // The panel's script has its own config, with browser types.
  "exclude": ["src/webview"]
}
