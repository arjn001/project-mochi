# Files left OUT of the .vsix package. Everything else goes in.
# The only code in the package is the bundle, dist/extension.js; CI fails
# if any other JavaScript, or src/ or out/, ends up in it.

# Source code, and the TypeScript output used by the tests and the
# developer-only tools (out/test/, out/dev/). The bundle replaces it.
src/**
out/**
**/*.map
tsconfig.json
esbuild.mjs

# Tests and the test copy of VS Code
.vscode-test/**
.vscode-test.mjs

# Editor, CI, and tool settings
.vscode/**
.github/**
.fantasticonrc.js
.nvmrc
.gitignore

# Docs live in the repo, not in the package (README.md stays in)
docs/**

# Local files that are already ignored by git
**/.DS_Store
CLAUDE.md
.jira-env
.env*
