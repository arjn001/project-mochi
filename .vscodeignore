# Files left OUT of the .vsix package. Everything else goes in.
# CI fails if src/, out/test/, or out/dev/ ever end up in the package.

# Source code, compiled tests, and developer-only tools
src/**
out/test/**
out/dev/**
**/*.map
tsconfig.json

# Tests and the test copy of VS Code
.vscode-test/**
.vscode-test.mjs

# Editor, CI, and tool settings
.vscode/**
.github/**
.fantasticonrc.js
.nvmrc
.gitignore

# Docs live in the repo, not in the package (README.md stays in)
docs/**

# Local files that are already ignored by git
**/.DS_Store
CLAUDE.md
.jira-env
.env*
