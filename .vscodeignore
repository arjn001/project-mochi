# Files left OUT of the .vsix package. Everything else goes in.
# The only code in the package is the bundle, dist/extension.js, and the
# panel's script, dist/webview/panel.js; CI fails if any other JavaScript,
# or src/ or out/, ends up in it.
# Runtime dependencies (like the Claude SDK) are bundled into it too, so
# `npm run package` leaves node_modules out (--no-dependencies).

# Source code, and the TypeScript output used by the tests and the
# developer-only tools (out/test/, out/dev/). The bundle replaces it.
src/**
out/**
**/*.map
tsconfig.json
esbuild.mjs

# Tests, the test copy of VS Code, and coverage (MOCHI-70)
.vscode-test/**
.vscode-test.mjs
.c8rc.json
coverage/**
scripts/**

# Editor, CI, and tool settings
.vscode/**
.github/**
.fantasticonrc.js
.nvmrc
.gitignore

# Docs live in the repo, not in the package (README.md stays in)
docs/**

# Local files that are already ignored by git
**/.DS_Store
CLAUDE.md
.jira-env
.env*
